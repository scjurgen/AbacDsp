{
  "name": "metronome",
  "plugintype": "Metronome",
  "description": [
    "✨ Metronome with settable BPM, start/stop and damped sine tick\n"
  ],
  "patches": true,
  "ports-control":
  [
    {"short": "BPM",  "type": "dial",   "display": "BPM",           "symbol": "bpm",         "default": 120, "range": [40, 250, 0.1, 1, false],  "precision": 1, "unit": "BPM",
      "cc": {"controller": 20, "valueLow": 60, "valueHigh": 180}},
    {"short": "DRP",  "type": "drop",   "display": "Drop Bars",      "symbol": "dropBars",   "default": 0, "signed": false,
      "listitems": ["Drop none", "Play 1 Drop 1", "Play 3 Drop 1", "Play 2 Drop 2", "Play 1 Drop 3"]},
    {"short": "MVOL", "type": "dial",   "display": "Metro Volume",   "symbol": "metroVolume", "default": -6,  "range": [-60, 0, 0.1, 1, false],   "precision": 1, "unit": "dB",
      "cc": {"controller": 21, "valueLow": -20, "valueHigh": -10}},
    {"short": "IVOL", "type": "dial",   "display": "Input Volume",   "symbol": "inputVolume", "default": 0,   "range": [-60, 12, 0.1, 1, false],   "precision": 1, "unit": "dB",
      "cc": {"controller": 22}},
    {"short": "SVOL", "type": "dial",   "display": "Sub Volume",     "symbol": "subVolume",   "default": -15, "range": [-60, 0, 0.1, 1, false],   "precision": 1, "unit": "dB",
      "cc": {"controller": 23}},
    {"short": "ONF",  "type": "switch", "display": "Start",          "symbol": "onOff",       "default": 0},
    {"short": "SYNC", "type": "switch", "display": "Host Sync",      "symbol": "hostSync",    "default": 0},
    {"short": "PRE",  "type": "drop",   "display": "Preset",         "symbol": "preset",      "default": 6,
      "listitems": ["3/4", "3/4 8th", "3/4 16th", "3/4 shuffle", "3/4 triplet", "4/4", "4/4 8th", "4/4 16th",
        "4/4 shuffle", "4/4 triplet", "4/4 swing", "5/4 (3+2)", "5/4 8th (3+2)", "5/4 (2+3)", "5/4 8th (2+3)",
        "6/8 in-2", "6/8 in-6", "7/8 (2+2+3)", "7/8 (2+3+2)", "7/8 (3+2+2)", "9/8 in-3", "9/8 in-9",
        "11/8 (3+3+3+2)", "11/8 (3+3+2+3)", "13/8 (3+3+3+2+2)", "13/8 (3+4+3+3)"]},
    {"short": "SWG",  "type": "dial",   "display": "Swing",          "symbol": "swingRatio",  "default": 1.5, "range": [1.0, 2.0, 0.01, 1, false],  "precision": 2, "unit": "",
     "visible_when": "processorRef.presetHasSwing(presetDrop.getSelectedItemIndex())",
     "depends_on": "preset",
     "cc": {"controller": 24}},
    {"short": "SIG",  "type": "gauge",  "gaugetype": "signal",       "display": "Beat",       "symbol": "signal",     "customtype": "CircularBeatDisplay",
      "bindings": [
        {"call": "setSampleRate", "from": "getSampleRate", "cast": "float"},
        {"call": "setBeatIndex", "from": "getWaveDataBeatIndex"},
        {"call": "setSubdivisionPositions", "from": "getSubdivisionPositions"}
      ]},
    {"short": "IRIS", "type": "gauge",  "gaugetype": "iris",         "display": "Spectrum Iris", "symbol": "iris", "customtype": "CircularSpectrogramDisplay",
      "bindings": [
        {"call": "setSampleRate", "from": "getSampleRate", "cast": "float"},
        {"call": "setBarBeats", "from": "getBarBeats"},
        {"call": "setBarPhase", "from": "getBarPhase"},
        {"call": "setSubdivisionPositions", "from": "getSubdivisionPositions"},
        {"call": "update", "from": "getInputSpectrogram"}
      ]}
  ],
  "layout": {
    "WINDOW_WIDTH": "960",
    "WINDOW_HEIGHT": "660",
    "type": "||",
    "composition": "C=(1:5) A1=(PRE, DRP, SWG, ONF, SYNC, BPM, SVOL, MVOL, IVOL) A2=(SIG%1, IRIS%2)"
  },
  "performance-page": {
    "type": "-",
    "composition": "A1=(SIG,IRIS)"
  },
  "extra_ui_includes": [
    "inc/CircularBeatDisplay.h",
    "inc/CircularSpectrogramDisplay.h"
  ],
  "extra_timer_callbacks": [
    "{ const float sr = static_cast<float>(processorRef.getSampleRate());",
    "const float bpm = processorRef.getCurrentClickBpm();",
    "const size_t spb = static_cast<size_t>(sr * 60.f / bpm);",
    "bpmDial.setEnabled(!processorRef.isHostSynced());",
    "if (processorRef.isHostSynced()) { bpmDial.setValue(bpm); }",
    "onOffSwitch.setEnabled(!processorRef.isHostSynced());",
    "signalGauge.setSamplesPerBeat(spb);",
    "irisGauge.setSamplesPerBeat(spb); }"
  ],
  "processor_forwards": [
    {"name": "getCurrentClickBpm", "call": "currentClickBpm", "type": "float", "default": "120.f"},
    {"name": "isHostSynced", "type": "bool"},
    {"name": "getWaveDataBeatIndex", "call": "getBeatIndex", "type": "size_t"},
    {"name": "getBarBeats", "type": "int", "default": 4},
    {"name": "getBarPhase", "type": "float"},
    {"name": "getInputSpectrogram", "call": "getSpectrogramData", "type": "AbacDsp::SpectrumImageSet"}
  ],
  "extra_processor_methods": [
    "[[nodiscard]] bool presetHasSwing(int idx) const noexcept { return pluginRunner && pluginRunner->isPresetSwing(idx); }",
    "[[nodiscard]] const std::vector<size_t>& getSubdivisionPositions() const noexcept { static const std::vector<size_t> empty{}; return pluginRunner ? pluginRunner->getSubdivisionPositions() : empty; }"
  ],
  "protected_files": [],
  "host_transport": true,
  "CPP":
  {
    "CLASS_NAME": "MetronomeImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/MetronomeImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
