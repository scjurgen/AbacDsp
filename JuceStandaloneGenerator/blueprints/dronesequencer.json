{
  "name": "dronesequencer",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "description": ["Lua-scripted drone sequencer - Karplus-Strong string ensemble driven by a user script."],
  "patches": true,
  "ports-control":
  [
    {"short": "VOL", "type": "dial", "display": "Level", "symbol": "level", "default": 0, "range": [-80, 0, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "TUNE", "type": "dial", "display": "Tuning", "symbol": "tuning", "default": 440, "range": [400, 800, 0.1, 1, false], "precision": 1, "unit": "Hz"},
    {"short": "TRAN", "type": "dial", "display": "Transpose", "symbol": "transpose", "default": 0, "range": [-24, 24, 1, 1, false], "precision": 0, "unit": "st"},
    {"short": "DET", "type": "dial", "display": "Detune", "symbol": "detune", "default": 5, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "ct"},

    {"short": "SCPT", "type": "script", "display": "Script", "symbol": "script"},

    {"short": "RDRY", "type": "dial", "display": "Reverb Dry", "symbol": "reverbDry", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "RWET", "type": "dial", "display": "Reverb Wet", "symbol": "reverbWet", "default": -100, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "RSZ", "type": "dial", "display": "Reverb Size", "symbol": "reverbSize", "default": 30, "range": [1, 330, 0.1, 0.4, false], "precision": 1, "unit": "m"},
    {"short": "RDEC", "type": "dial", "display": "Reverb Decay", "symbol": "reverbDecay", "default": 2000, "range": [1, 100000, 1, 0.2, false], "precision": 0, "unit": "ms"},
    {"short": "RSLO", "type": "dial", "display": "Reverb Shelf Low", "symbol": "reverbShelfLow", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "RSHI", "type": "dial", "display": "Reverb Shelf High", "symbol": "reverbShelfHigh", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB"},

    {"short": "PLAY", "type": "switch", "display": "Play", "symbol": "playStop", "default": 0},
    {"short": "HTIM", "type": "dial", "display": "Humanize Timing", "symbol": "humanizeTiming", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%"},
    {"short": "HLVL", "type": "dial", "display": "Humanize Level", "symbol": "humanizeLevel", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%"},
    {"short": "BPM", "type": "dial", "display": "BPM", "symbol": "bpm", "default": 120, "range": [40, 250, 0.1, 1, false], "precision": 1, "unit": "BPM"},
    {"short": "SYNC", "type": "switch", "display": "Host Sync", "symbol": "hostSync", "default": 0},
    {"short": "DIV", "type": "drop", "display": "Division", "symbol": "division", "default": 4,
      "listitems": ["1/1", "1/2", "1/2.", "1/2T", "1/4", "1/4.", "1/4T", "1/8", "1/8.", "1/8T", "1/16", "1/16.", "1/16T"]},

    {"short": "ATK", "type": "dial", "display": "Attack", "symbol": "attack", "default": 10, "range": [1, 3000, 0.1, 0.35, false], "precision": 1, "unit": "ms"},
    {"short": "DCY", "type": "dial", "display": "Decay", "symbol": "decay", "default": 30000, "range": [1, 100000, 1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "DCYO", "type": "dial", "display": "Decay Octave", "symbol": "decayOctave", "default": 1, "range": [0, 2, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "DAMP", "type": "dial", "display": "Damper", "symbol": "damper", "default": 0, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "SUS", "type": "dial", "display": "Sustain", "symbol": "levelSustain", "default": 0.2, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "SUSH", "type": "dial", "display": "Sustain Humanize", "symbol": "sustainHumanize", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%"},
    {"short": "LFOD", "type": "dial", "display": "Filter LFO Depth", "symbol": "lfoDepth", "default": 0.5, "range": [0, 2, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "LFOS", "type": "dial", "display": "Filter LFO Speed", "symbol": "lfoSpeed", "default": 0.5, "range": [0.01, 20, 0.01, 0.25, false], "precision": 2, "unit": "Hz"},
    {"short": "LFOV", "type": "dial", "display": "Filter LFO Variation", "symbol": "lfoSpeedVariation", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%"},

    {"short": "ATKF", "type": "dial", "display": "Filter Attack", "symbol": "attackFilter", "default": 10, "range": [1, 3000, 0.1, 0.35, false], "precision": 1, "unit": "ms"},
    {"short": "DCYF", "type": "dial", "display": "Filter Decay", "symbol": "decayFilter", "default": 1000, "range": [1, 30000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "SUSF", "type": "dial", "display": "Filter Sustain", "symbol": "levelSustainFilter", "default": 0, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "CUTF", "type": "dial", "display": "Filter Cutoff", "symbol": "filterCutoff", "default": 0, "range": [-60, 48, 0.1, 1, false], "precision": 1, "unit": "st"},
    {"short": "RESF", "type": "dial", "display": "Filter Resonance", "symbol": "filterResonance", "default": 0.1, "range": [0, 2, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "CONTF", "type": "dial", "display": "Contour F", "symbol": "contourFilter", "default": 0, "range": [-4, 4, 0.01, 1, false], "precision": 2, "unit": "oct"},
    {"short": "FFT", "type":"gauge", "gaugetype" : "spectrogram", "display": "Spectrogram", "symbol": "spectrogram"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1400",
    "WINDOW_HEIGHT": "800",
    "type": "=5",
    "composition": "R=(1:1:1:1:1) A1=(VOL,TUNE,TRAN,DET,SCPT) A2=(PLAY,BPM,SYNC,DIV,HTIM,HLVL) A3=(ATK,DCY,DCYO,DAMP,SUS,SUSH,LFOD,LFOS,LFOV) A4=(ATKF,DCYF,SUSF,CUTF,RESF,CONTF) A5=(RDRY,RWET,RSZ,RDEC,RSLO,RSHI)"
  },
  "performance-page": {
    "type": "=3",
    "composition": "R=(1:1:2) A1=(PLAY,BPM,VOL,SCPT) A2=(RDRY,RWET,RSZ,RDEC) A3=(FFT)"
  },
  "extra_timer_callbacks": [
    "bpmDial.setEnabled(!processorRef.isHostSynced());",
    "if (processorRef.isHostSynced()) { bpmDial.setValue(processorRef.getCurrentBpm()); }",
    "playStopSwitch.setEnabled(!processorRef.isHostSynced());",
    "if (processorRef.isHostSynced()) { playStopSwitch.setToggleState(processorRef.getIsEffectivelyPlaying(), juce::dontSendNotification); }",
    "pollScriptError();"
  ],
  "processor_forwards": [
    {"name": "getCurrentBpm", "call": "currentBpm", "type": "float", "default": "120.f"},
    {"name": "isHostSynced", "type": "bool"},
    {"name": "getIsEffectivelyPlaying", "call": "effectivePlaying", "type": "bool"},
    {"name": "hasScriptError", "type": "bool"},
    {"name": "scriptErrorMessage", "call": "scriptError", "type": "std::string"},
    {"name": "getScriptSkeleton", "call": "scriptSkeleton", "type": "std::string"}
  ],
  "host_transport": true,
  "CPP":
  {
    "CLASS_NAME": "DroneSequencerImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/DroneSequencerImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
