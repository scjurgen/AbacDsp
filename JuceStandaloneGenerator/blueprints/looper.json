{
  "name": "looper",
  "plugintype": "Looper",
  "description": [
    "Records audio, quantizes the loop to whole bars, slices it (grid or transient),\n",
    "and plays the slices back locked to a BPM/swing grid with a metronome click.\n"
  ],
  "patches": true,
  "loops": true,
  "host_transport": true,
  "ports-control": [
    {"short": "REC",  "type": "switch", "display": "Record",   "symbol": "record",   "default": 0, "momentary": true, "cc": {"controller": 64}},
    {"short": "PLAY", "type": "switch", "display": "Play",      "symbol": "play",     "default": 0, "momentary": true, "cc": {"controller": 66},
      "state_label": {"query": "isPlaying", "on": "Stop", "off": "Play"}},
    {"short": "ODUB", "type": "switch", "display": "Overdub",   "symbol": "overdub",  "default": 0, "momentary": true, "cc": {"controller": 65},
      "state_label": {"query": "isOverdubbing", "on": "Overdubbing", "off": "Overdub"}},
    {"short": "CLR",  "type": "switch", "display": "Clear",     "symbol": "clear",    "default": 0, "momentary": true, "cc": {"controller": 69}},
    {"short": "TREC", "type": "switch", "display": "Thresh Rec", "symbol": "threshRec", "default": 0, "cc": {"controller": 70}},
    {"short": "SYNC", "type": "switch", "display": "Host Sync", "symbol": "hostSync", "default": 0},
    {"short": "MODE", "type": "drop",   "display": "Slice Mode", "symbol": "sliceMode", "default": 0,
      "listitems": ["Grid", "Transient"]},
    {"short": "DIV",  "type": "drop",   "display": "Division",   "symbol": "sliceDivision", "default": 1,
      "listitems": ["1/4", "1/8", "1/16", "1/32"]},
    {"short": "BPM",  "type": "dial",   "display": "BPM",         "symbol": "bpm",        "default": 120,
      "range": [50, 250, 0.1, 1, false], "precision": 1, "unit": "BPM",
      "cc": {"controller": 20, "valueLow": 60, "valueHigh": 180}},
    {"short": "SWG",  "type": "dial",   "display": "Swing",       "symbol": "swing",      "default": 50,
      "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%",
      "cc": {"controller": 21}},
    {"short": "CVOL", "type": "dial",   "display": "Click Volume", "symbol": "clickVolume", "default": -12,
      "range": [-60, 0, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 22}},
    {"short": "CTRK", "type": "dial",   "display": "Click->Track", "symbol": "clickRecordVolume", "default": -60,
      "range": [-60, 0, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 25}},
    {"short": "LVOL", "type": "dial",   "display": "Loop Volume",  "symbol": "loopVolume", "default": 0,
      "range": [-60, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 23}},
    {"short": "THR",  "type": "dial",   "display": "Rec Threshold", "symbol": "recThreshold", "default": -36,
      "range": [-60, 0, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 24}},
    {"short": "FRZ",  "type": "switch", "display": "Freeze",     "symbol": "freeze",     "default": 0, "momentary": true, "cc": {"controller": 71}},
    {"short": "SEQP", "type": "switch", "display": "Seq Play",  "symbol": "seqPlay",   "default": 0, "momentary": true, "cc": {"controller": 75},
      "state_label": {"query": "isSequencerPlaying", "on": "Seq Stop", "off": "Seq Play"}},
    {"short": "CLRS", "type": "switch", "display": "Clear Seq", "symbol": "clearSeq",  "default": 0, "momentary": true, "cc": {"controller": 76}},
    {"short": "SAVW", "type": "switch", "display": "Save Wave", "symbol": "saveWave",  "default": 0, "momentary": true, "cc": {"controller": 77}},
    {"short": "BEAT", "type": "gauge", "gaugetype": "signal", "display": "Bar", "symbol": "beat",
      "customtype": "CircularLoopDisplay",
      "bindings": [
        {"call": "setSampleRate", "from": "getSampleRate", "cast": "float"},
        {"call": "setSamplesPerBar", "from": "getSamplesPerBar"},
        {"call": "setBarBeats", "from": "getBarBeats"},
        {"call": "setBarPhase", "from": "getBarPhase"},
        {"call": "setSubdivisionPositions", "from": "getSubdivisionPositions"},
        {"call": "setLoopWaveform", "from": "getLoopWaveform"},
        {"call": "setSliceBoundaries", "from": "getSliceBoundaries"},
        {"call": "setPlayheadNormalized", "from": "getPlayheadNormalized"},
        {"call": "setOuterRingBars", "from": "getOuterRingBars"},
        {"call": "setStateLabel", "from": "getLooperStateLabel"},
        {"call": "setSpectrogram", "from": "getSpectrogramData"},
        {"call": "setRecordHeadFrames", "from": "getSpectrogramHeadFrames"}
      ]},
    {"short": "SLICE", "type": "gauge", "gaugetype": "signal", "display": "Sequencer", "symbol": "slice",
      "customtype": "SliceWaveDisplay",
      "bindings": [
        {"call": "setSampleRate", "from": "getSampleRate", "cast": "float"},
        {"call": "setSliceThumbnails", "from": "getSequencerSliceThumbnails"},
        {"call": "setSliceBoundaries", "from": "getSequencerSliceBoundaries"},
        {"call": "setPlayheadNormalized", "from": "getSequencerPlayheadNormalized"},
        {"call": "setStateLabel", "from": "getSequencerLabel"}
      ]}
  ],
  "layout": {
    "WINDOW_WIDTH": "1200",
    "WINDOW_HEIGHT": "640",
    "type": "|||",
    "composition": "C=(1:1:5) A1=(REC, PLAY, ODUB, CLR, TREC, SYNC, MODE, DIV, FRZ, SEQP, CLRS, SAVW) A2=(BPM, SWG, CVOL, CTRK, LVOL, THR) A3=(BEAT%5, SLICE%1)"
  },
  "extra_ui_includes": [
    "inc/SliceWaveDisplay.h",
    "inc/CircularLoopDisplay.h"
  ],
  "extra_timer_callbacks": [
    "recordSwitch.setButtonText(processorRef.isRecording() ? juce::String::fromUTF8(\"Recording\") : (processorRef.isArmed() ? juce::String::fromUTF8(\"Armed\") : juce::String::fromUTF8(\"Record\")));",
    "freezeSwitch.setButtonText(processorRef.isFreezePending() ? juce::String::fromUTF8(\"Freezing...\") : (juce::String::fromUTF8(\"Freeze (\") + juce::String(processorRef.getFrozenTrackCount()) + juce::String::fromUTF8(\" trk/\") + juce::String(processorRef.getFrozenSliceCount()) + juce::String::fromUTF8(\" sl)\")));",
    "saveWaveSwitch.setButtonText(processorRef.isSaveWavePending() ? juce::String::fromUTF8(\"Saving...\") : juce::String::fromUTF8(\"Save Wave\"));",
    "if (const auto saved = processorRef.consumeLastSavedWaveFilename(); saved.isNotEmpty()) { m_statusBar.showMessage(juce::String::fromUTF8(\"Saved: \") + juce::File(saved).getFileName()); }",
    "if (const auto saved = processorRef.consumeLastSavedLoopName(); saved.isNotEmpty()) { m_statusBar.showMessage(juce::String::fromUTF8(\"Saved '\") + saved + \"'\"); }",
    "handleLoopLoadOutcome();"
  ],
  "processor_forwards": [
    {"name": "isHostSynced", "type": "bool"},
    {"name": "isRecording", "type": "bool"},
    {"name": "isPlaying", "type": "bool"},
    {"name": "isOverdubbing", "type": "bool"},
    {"name": "isArmed", "type": "bool"},
    {"name": "getLoopWaveform", "type": "std::vector<float>"},
    {"name": "getSliceBoundaries", "type": "std::vector<float>"},
    {"name": "getPlayheadNormalized", "type": "float"},
    {"name": "getSamplesPerBar", "type": "size_t"},
    {"name": "getBarBeats", "type": "int", "default": 4},
    {"name": "getOuterRingBars", "type": "int", "default": 1},
    {"name": "getSpectrogramData", "type": "AbacDsp::SpectrumImageSet"},
    {"name": "getSpectrogramHeadFrames", "type": "size_t"},
    {"name": "getBarPhase", "type": "float"},
    {"name": "isFreezePending", "type": "bool"},
    {"name": "getFrozenTrackCount", "type": "size_t"},
    {"name": "getFrozenSliceCount", "type": "size_t"},
    {"name": "isSequencerPlaying", "type": "bool"},
    {"name": "getSequencerSliceThumbnails", "type": "std::vector<AbacDsp::SequencerSliceThumbnail>"},
    {"name": "getSequencerSliceBoundaries", "type": "std::vector<float>"},
    {"name": "getSequencerPlayheadNormalized", "type": "float"},
    {"name": "isSaveWavePending", "type": "bool"},
    {"name": "isLoopSavePending", "type": "bool"},
    {"name": "isLoopLoadPending", "type": "bool"}
  ],
  "extra_processor_methods": [
    "[[nodiscard]] const std::vector<size_t>& getSubdivisionPositions() const noexcept { static const std::vector<size_t> empty{}; return pluginRunner ? pluginRunner->getSubdivisionPositions() : empty; }",
    "[[nodiscard]] juce::String getLooperStateLabel() const { return pluginRunner ? juce::String(pluginRunner->getStateLabel()) : juce::String(); }",
    "[[nodiscard]] juce::String getSequencerLabel() const { return pluginRunner ? juce::String(pluginRunner->getSequencerStateLabel()) : juce::String(); }",
    "static std::string getExportDirectory() {\n        auto base = juce::File::getSpecialLocation(juce::File::userApplicationDataDirectory);\n#if JUCE_MAC\n        base = base.getChildFile(\"Application Support\");\n#endif\n        const auto dir = base.getChildFile(\"AbacDsp\").getChildFile(\"Looper\").getChildFile(\"exports\");\n        dir.createDirectory();\n        return dir.getFullPathName().toStdString();\n    }",
    "[[nodiscard]] juce::String consumeLastSavedWaveFilename() const { return pluginRunner ? juce::String(pluginRunner->consumeLastSavedFilename()) : juce::String(); }",
    "static std::string getLoopsDirectory() {\n        auto base = juce::File::getSpecialLocation(juce::File::userApplicationDataDirectory);\n#if JUCE_MAC\n        base = base.getChildFile(\"Application Support\");\n#endif\n        const auto dir = base.getChildFile(\"AbacDsp\").getChildFile(\"Looper\").getChildFile(\"loops\");\n        dir.createDirectory();\n        return dir.getFullPathName().toStdString();\n    }",
    "[[nodiscard]] std::vector<juce::String> listLoopNames() const { std::vector<juce::String> result; if (pluginRunner) { for (const auto& n : pluginRunner->listLoopNames()) { result.push_back(juce::String(n)); } } return result; }",
    "void saveLoopAs(const juce::String& name) { if (pluginRunner) { pluginRunner->requestSaveLoopAs(name.toStdString()); } }",
    "void requestLoadLoop(const juce::String& name) { if (pluginRunner) { pluginRunner->requestLoadLoop(name.toStdString()); } }",
    "bool deleteLoopNamed(const juce::String& name) { return pluginRunner && pluginRunner->deleteLoopNamed(name.toStdString()); }",
    "bool renameLoop(const juce::String& oldName, const juce::String& newName) { return pluginRunner && pluginRunner->renameLoopNamed(oldName.toStdString(), newName.toStdString()); }",
    "[[nodiscard]] juce::String consumeLastSavedLoopName() const { return pluginRunner ? juce::String(pluginRunner->consumeLastSavedLoopName()) : juce::String(); }",
    "[[nodiscard]] LooperImpl<NumSamplesPerBlock>::LoopLoadOutcome consumeLoopLoadOutcome() const { return pluginRunner ? pluginRunner->consumeLoopLoadOutcome() : LooperImpl<NumSamplesPerBlock>::LoopLoadOutcome{}; }",
    "void resolveLoopLoadBpm(const float bpm) { if (pluginRunner) { pluginRunner->resolveLoopLoadBpm(bpm); } }"
  ],
  "extra_prepare_calls": [
    "pluginRunner->setExportDirectory(getExportDirectory());",
    "pluginRunner->setLoopsDirectory(getLoopsDirectory());"
  ],
  "protected_files": ["src/unittests/Looper_tests.cpp"],
  "CPP": {
    "CLASS_NAME": "LooperImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/LooperImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
