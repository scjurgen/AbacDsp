{
  "name": "juliasynth",
  "displayname": "JuliaSynth",
  "status": "beta",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "color": "#eeeeee",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "micro": 127,
  "minor": 1,
  "major": 0,
  "shortdescription": "Just a miniature synth",
  "description": ["✨ Just a miniature synth. "],
  "midi-ports-in": [],
  "midi-ports-out": [],
  "audio-ports-in": [{ "name": "in", "symbol":  "in"}],
  "audio-ports-out": [{ "name": "left", "symbol":  "left"},{ "name": "right", "symbol":  "right"}],
  "ports-control":
  [
    {"short": "VOL", "type": "dial", "display": "Vol", "symbol": "vol", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "POW", "type": "dial", "display": "Power", "symbol": "power", "default": 2, "range": [1, 10, 0.1, 1, false], "precision": 1, "unit": ""},
    {"short": "CX", "type": "dial", "display": "CX", "symbol": "cx", "default": 0, "range": [-2, 2, 0.00001, 1, false], "precision": 5, "unit": ""},
    {"short": "CY", "type": "dial", "display": "CY", "symbol": "cy", "default": 0, "range": [-2, 2, 0.00001, 1, false], "precision": 5, "unit": ""},
    {"short": "JX", "type": "dial", "display": "JX", "symbol": "jx", "default": 0, "range": [-2, 2, 0.00001, 1, false], "precision": 5, "unit": ""},
    {"short": "JY", "type": "dial", "display": "JY", "symbol": "jy", "default": 0, "range": [-2, 2, 0.00001, 1, false], "precision": 5, "unit": ""},
    {"short": "JRX", "type": "dial", "display": "JR-X", "symbol": "jrx", "default": 1, "range": [0, 2, 0.001, 1, false], "precision": 3, "unit": ""},
    {"short": "JRY", "type": "dial", "display": "JR-Y", "symbol": "jry", "default": 1, "range": [0, 2, 0.001, 1, false], "precision": 3, "unit": ""},

    {"short": "CPU", "type":"gauge", "gaugetype" : "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "LVL", "type":"gauge", "gaugetype" : "levels", "display": "Level", "symbol": "level", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "FFT", "type":"gauge", "gaugetype" : "spectrogram", "display": "Spectrogram", "symbol": "spectrogram"},
    {"short": "SIG", "type" : "signal", "display": "Signal", "symbol": "signal"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1200",
    "WINDOW_HEIGHT": "600",
    "type": "|=",
     "composition": "C=(1:9) R(1:3) A1=(VOL,LVL*200,CPU*200) A2=(CX,CY,JX,JY,JRX,JRY) A4=(FFT%1, SIG%1)"
  },
  "CPP":
  {
    "CLASS_NAME": "JuliaSynth<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/JuliaSynth.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
