{
  "name": "maxdiffuser",
  "plugintype": "ReverbPlugin",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#ReverbPlugin",
  "description": ["Diffuser delay chain: up to 50 modulated allpass delays in series with pre-delay, pitching, bulge size distribution and damping."],
  "patches": true,
  "ports-control":
  [
    {"short": "DRY", "type": "dial", "display": "Dry", "symbol": "dry", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 20}},
    {"short": "WET", "type": "dial", "display": "Wet", "symbol": "wet", "default": -6, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 21}},
    {"short": "PRED", "type": "dial", "display": "Pre Delay", "symbol": "preDelay", "default": 0, "range": [0, 1000, 1, 0.5, false], "precision": 0, "unit": "ms",
      "cc": {"controller": 22}},
    {"short": "ELM", "type": "dial", "display": "Elements", "symbol": "elements", "default": 6, "range": [0, 50, 1, 1, false], "precision": 0, "unit": "",
      "cc": {"controller": 23}},
    {"short": "SPAN", "type": "dial", "display": "Tap Span", "symbol": "tapSpan", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%",
      "cc": {"controller": 40}},
    {"short": "FDBK", "type": "dial", "display": "Diffusion", "symbol": "feedback", "default": 50, "range": [-100, 100, 0.1, 1, false], "precision": 1, "unit": "%",
      "cc": {"controller": 24}},
    {"short": "BLG", "type": "dial", "display": "Bulge", "symbol": "bulge", "default": 0.46, "range": [-1, 1, 0.01, 1, false], "precision": 2, "unit": "",
      "cc": {"controller": 25}},
    {"short": "BSZ", "type": "dial", "display": "Early Size", "symbol": "bottomSize", "default": 0.7, "range": [0.5, 100.0, 0.1, 0.4, false], "precision": 1, "unit": "m",
      "cc": {"controller": 26}},
    {"short": "TSZ", "type": "dial", "display": "Late Size", "symbol": "topSize", "default": 7.0, "range": [0.5, 100.0, 0.1, 0.4, false], "precision": 1, "unit": "m",
      "cc": {"controller": 27}},
    {"short": "SPRD", "type": "dial", "display": "Size Spread", "symbol": "sizeSpread", "default": 0, "range": [0, 10, 0.01, 0.5, false], "precision": 2, "unit": "m",
      "cc": {"controller": 36}},
    {"short": "MDPT", "type": "dial", "display": "Mod Depth", "symbol": "modulationDepth", "default": 0, "range": [0, 1, 0.001, 0.35, false], "precision": 3, "unit": "",
      "cc": {"controller": 28}},
    {"short": "MDSP", "type": "dial", "display": "Mod Speed", "symbol": "modulationSpeed", "default": 0.5, "range": [0.01, 5, 0.01, 0.5, false], "precision": 2, "unit": "Hz",
      "cc": {"controller": 29}},
    {"short": "LPF", "type": "dial", "display": "Low Pass", "symbol": "lowPass", "default": 12000, "range": [20, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz",
      "cc": {"controller": 30}},
    {"short": "MIX", "type": "dial", "display": "Pitch Mix", "symbol": "mix", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%",
      "cc": {"controller": 31}},
    {"short": "PTCH", "type": "dial", "display": "Pitch", "symbol": "pitch", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": "st",
      "cc": {"controller": 32}},
    {"short": "PTDL", "type": "dial", "display": "Pitch Delay", "symbol": "pitchDelay", "default": 0, "range": [0, 1000, 1, 0.5, false], "precision": 0, "unit": "ms",
      "cc": {"controller": 38}},
    {"short": "PTCH2", "type": "dial", "display": "Pitch 2", "symbol": "pitch2", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": "st",
      "cc": {"controller": 37}},
    {"short": "PTDL2", "type": "dial", "display": "Pitch 2 Delay", "symbol": "pitch2Delay", "default": 0, "range": [0, 1000, 1, 0.5, false], "precision": 0, "unit": "ms",
      "cc": {"controller": 39}},
    {"short": "PMOD", "type": "drop", "display": "Pitch Mode", "symbol": "pitchMode", "default": 0,
      "listitems": ["Drift", "Sync", "Vocoder"]},
    {"short": "FMIX", "type": "dial", "display": "Reverb Mix", "symbol": "fdnMix", "default": -100, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 33}},
    {"short": "FSZ", "type": "dial", "display": "Reverb Size", "symbol": "fdnSize", "default": 30, "range": [1, 330, 0.1, 0.4, false], "precision": 1, "unit": "m",
      "cc": {"controller": 34}},
    {"short": "FDEC", "type": "dial", "display": "Reverb Decay", "symbol": "fdnDecay", "default": 2000, "range": [1, 100000, 1, 0.2, false], "precision": 0, "unit": "ms",
      "cc": {"controller": 35}},
    {"short": "DRV", "type": "dial", "display": "Drive", "symbol": "drive", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%",
      "cc": {"controller": 41}},
    {"short": "EQIL", "type": "dial", "display": "EQ In Low", "symbol": "eqInLow", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 42}},
    {"short": "EQIM", "type": "dial", "display": "EQ In Mid", "symbol": "eqInMid", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 43}},
    {"short": "EQIH", "type": "dial", "display": "EQ In High", "symbol": "eqInHigh", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 44}},
    {"short": "EQOL", "type": "dial", "display": "EQ Out Low", "symbol": "eqOutLow", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 45}},
    {"short": "EQOM", "type": "dial", "display": "EQ Out Mid", "symbol": "eqOutMid", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 46}},
    {"short": "EQOH", "type": "dial", "display": "EQ Out High", "symbol": "eqOutHigh", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 47}},
    {"short": "LVL", "type": "dial", "display": "Level", "symbol": "level", "default": 0, "range": [-24, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 48}},
    {"short": "PSLO", "type": "dial", "display": "Pitcher Shelf Low", "symbol": "pitcherShelfLow", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 49}},
    {"short": "PSHI", "type": "dial", "display": "Pitcher Shelf High", "symbol": "pitcherShelfHigh", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 50}},
    {"short": "XTAP", "type": "switch", "display": "Extreme Stereo Tap", "symbol": "extremeStereoTap", "default": 0},
    {"short": "WIDE", "type": "dial", "display": "Wide", "symbol": "wide", "default": 0, "range": [-100, 100, 0.1, 1, false], "precision": 1, "unit": "%",
      "cc": {"controller": 51}},
    {"short": "RSLO", "type": "dial", "display": "Reverb Shelf Low", "symbol": "reverbShelfLow", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 52}},
    {"short": "RSHI", "type": "dial", "display": "Reverb Shelf High", "symbol": "reverbShelfHigh", "default": 0, "range": [-18, 18, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 53}},
    {"short": "BINSB", "type": "gauge", "gaugetype": "processingbins", "display": "Bands", "symbol": "binsBands", "customtype": "ShowProcessingBinsBands"},
    {"short": "SIZES", "type": "gauge", "gaugetype": "processingbins", "display": "Sizes", "symbol": "sizes", "customtype": "ShowDiffuserSizes"}
  ],
  "layout": {
    "WINDOW_WIDTH": "800",
    "WINDOW_HEIGHT": "600",
    "type": "=5",
    "composition": "R=(3:2:3:2:2) A1=(DRY,WET,PRED,DRV,EQIL,EQIM,EQIH,EQOL,EQOM,EQOH,LVL) A2=(MIX,PTCH,PTDL,PTCH2,PTDL2,PMOD,PSLO,PSHI) A3=(ELM,SPAN,FDBK,BLG,BSZ,TSZ,SPRD,MDPT,MDSP,LPF,XTAP,WIDE) A4=(FMIX,FSZ,FDEC,RSLO,RSHI) A5=(SIZES)"
  },
  "performance-page": {
    "type": "≡",
    "composition": "R=(1:1:2) A1=(DRY,WET,SPAN,FDBK) A2=(FMIX,FSZ, FDEC) A3=(BINSB)"
  },
  "extra_ui_includes": [
    "impl/ShowProcessingBins.h",
    "impl/ShowProcessingBinsBands.h",
    "impl/ShowDiffuserSizes.h"
  ],
  "processor_forwards": [
    {"name": "getProcessingBinLevels", "type": "std::array<float, 51>", "noexcept": true},
    {"name": "getProcessingBinBandLevels", "type": "std::array<std::array<float, 3>, 51>", "noexcept": true},
    {"name": "getElementSizesInMeters", "type": "std::array<float, 50>", "noexcept": true}
  ],
  "extra_timer_callbacks": [
    "binsBandsGauge.update(processorRef.getProcessingBinBandLevels(), static_cast<size_t>(valueTreeState.getRawParameterValue(\"elements\")->load()));",
    "sizesGauge.update(processorRef.getElementSizesInMeters(), processorRef.getProcessingBinBandLevels(), static_cast<size_t>(valueTreeState.getRawParameterValue(\"elements\")->load()));"
  ],
  "CPP":
  {
    "CLASS_NAME": "MaxDiffuserImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/MaxDiffuserImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
