{
  "name": "maxdiffuser",
  "displayname": "Max Diffuser",
  "status": "beta",
  "plugintype": "ReverbPlugin",
  "color": "#77ccee",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#ReverbPlugin",
  "micro": 127,
  "minor": 1,
  "major": 0,
  "shortdescription": "Diffuser delay chain (up to 50 modulated allpass delays in series)",
  "description": ["Diffuser delay chain: up to 50 modulated allpass delays in series with pre-delay, pitching, bulge size distribution and damping."],
  "ports-control":
  [
    {"short": "PBR", "type": "presetbrowser", "display": "Patch", "symbol": "patch"},
    {"short": "STAT", "type": "statusbar", "display": "Status", "symbol": "patchStatus"},
    {"short": "DRY", "type": "dial", "display": "Dry", "symbol": "dry", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 20}},
    {"short": "WET", "type": "dial", "display": "Wet", "symbol": "wet", "default": -6, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 21}},
    {"short": "PRED", "type": "dial", "display": "Pre Delay", "symbol": "preDelay", "default": 0, "range": [0, 1000, 1, 0.5, false], "precision": 0, "unit": "ms",
      "cc": {"controller": 22}},
    {"short": "ELM", "type": "dial", "display": "Elements", "symbol": "elements", "default": 6, "range": [0, 50, 1, 1, false], "precision": 0, "unit": "",
      "cc": {"controller": 23}},
    {"short": "FDBK", "type": "dial", "display": "Diffusion", "symbol": "feedback", "default": 50, "range": [-100, 100, 0.1, 1, false], "precision": 1, "unit": "%",
      "cc": {"controller": 24}},
    {"short": "BLG", "type": "dial", "display": "Bulge", "symbol": "bulge", "default": 0.46, "range": [-1, 1, 0.01, 1, false], "precision": 2, "unit": "",
      "cc": {"controller": 25}},
    {"short": "BSZ", "type": "dial", "display": "Bottom Size", "symbol": "bottomSize", "default": 0.7, "range": [0.5, 100.0, 0.1, 0.4, false], "precision": 1, "unit": "m",
      "cc": {"controller": 26}},
    {"short": "TSZ", "type": "dial", "display": "Top Size", "symbol": "topSize", "default": 7.0, "range": [0.5, 100.0, 0.1, 0.4, false], "precision": 1, "unit": "m",
      "cc": {"controller": 27}},
    {"short": "MDPT", "type": "dial", "display": "Mod Depth", "symbol": "modulationDepth", "default": 0, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": "",
      "cc": {"controller": 28}},
    {"short": "MDSP", "type": "dial", "display": "Mod Speed", "symbol": "modulationSpeed", "default": 0.5, "range": [0.01, 5, 0.01, 0.5, false], "precision": 2, "unit": "Hz",
      "cc": {"controller": 29}},
    {"short": "LPF", "type": "dial", "display": "Low Pass", "symbol": "lowPass", "default": 12000, "range": [20, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz",
      "cc": {"controller": 30}},
    {"short": "MIX", "type": "dial", "display": "Pitch Mix", "symbol": "mix", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%",
      "cc": {"controller": 31}},
    {"short": "PTCH", "type": "dial", "display": "Pitch", "symbol": "pitch", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": "st",
      "cc": {"controller": 32}},
    {"short": "PSYN", "type": "switch", "display": "Pitch Sync", "symbol": "psola", "default": 0},
    {"short": "FMIX", "type": "dial", "display": "FDN Mix", "symbol": "fdnMix", "default": -100, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB",
      "cc": {"controller": 33}},
    {"short": "FSZ", "type": "dial", "display": "FDN Size", "symbol": "fdnSize", "default": 30, "range": [1, 330, 0.1, 0.4, false], "precision": 1, "unit": "m",
      "cc": {"controller": 34}},
    {"short": "FDEC", "type": "dial", "display": "FDN Decay", "symbol": "fdnDecay", "default": 2000, "range": [1, 100000, 1, 0.2, false], "precision": 0, "unit": "ms",
      "cc": {"controller": 35}},
    {"short": "CPU", "type": "gauge", "gaugetype": "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%"},
    {"short": "LVL", "type": "gauge", "gaugetype": "levels", "display": "Level", "symbol": "level", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%"},
    {"short": "BINS", "type": "gauge", "gaugetype": "processingbins", "display": "Bins", "symbol": "bins", "customtype": "ShowProcessingBins<BinsDisplayMode::ShowContinuousLine, LevelUnit::Decibel>"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1100",
    "WINDOW_HEIGHT": "850",
    "type": "|=5",
    "composition": "C=(1:6) R=(1:2:1:1:1) A1=(PBR*40,STAT*30,LVL,CPU) A2=(DRY,WET,PRED,MIX,PTCH,PSYN) A3=(ELM,FDBK,BLG,BSZ,TSZ) A4=(MDPT,MDSP,LPF) A5=(FMIX,FSZ,FDEC) A6=(BINS)"
  },
  "extra_ui_includes": [
    "impl/ShowProcessingBins.h"
  ],
  "extra_processor_methods": [
    "[[nodiscard]] std::array<float, 51> getProcessingBinLevels() const noexcept { static constexpr std::array<float, 51> empty{}; return pluginRunner ? pluginRunner->getProcessingBinLevels() : empty; }"
  ],
  "extra_timer_callbacks": [
    "binsGauge.update(processorRef.getProcessingBinLevels(), static_cast<size_t>(valueTreeState.getRawParameterValue(\"elements\")->load()));"
  ],
  "CPP":
  {
    "CLASS_NAME": "MaxDiffuserImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/MaxDiffuserImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
