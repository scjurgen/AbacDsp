{
  "name": "waveexplorer",
  "displayname": "waveexplorer",
  "status": "beta",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "color": "#eeeeee",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "micro": 127,
  "minor": 1,
  "major": 0,
  "shortdescription": "Just an explorer",
  "description": ["✨ Just an explorer. "],
  "midi-ports-in": [],
  "midi-ports-out": [],
  "audio-ports-in": [{ "name": "in", "symbol":  "in"}],
  "audio-ports-out": [{ "name": "left", "symbol":  "left"},{ "name": "right", "symbol":  "right"}],
  "ports-control":
  [
    {"short": "VOL", "type": "dial", "display": "Vol", "symbol": "vol", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "REV", "type": "dial", "display": "Reverb", "symbol": "reverbLevel", "default": -24, "range": [-120, 0, 1, 1, false], "precision": 0, "unit": "dB"},

    {"short": "WAV", "type": "drop", "display": "Wave", "symbol": "wave", "default": 0, "listitems": [ "Silence",  "Square", "Saw", "Triangle", "Sine", "DiracRandom", "DampedSineTrain", "WhiteNoise",
      "PinkNoise", "BrownNoise", "VarTimeNoise"]},
    {"short": "ATT", "type": "dial", "display": "Attack", "symbol": "attack", "default": 10, "range": [1, 1000, 0.1, 0.5, false], "precision": 1, "unit": "ms"},
    {"short": "DEC", "type": "dial", "display": "Decay", "symbol": "decay", "default": 100, "range": [1, 2000, 0.1, 0.5, false], "precision": 1, "unit": "ms"},
    {"short": "SUS", "type": "dial", "display": "Sustain", "symbol": "sustain", "default": 0.8, "range": [-1, 2, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "WRPT", "type": "drop", "display": "Warp type", "symbol": "warpType", "default": 0, "listitems":  ["None","Square", "Cubic", "Power4", "Cubic2","Interval"]},

    {"short": "DSTT", "type": "drop", "display": "Distortion", "symbol": "distortionType", "default": 0, "listitems": [ 
      "classic silicon", "classic germanium", "classic soft", "classic soft tanh", "classic medium", "classic hard", "classic fuzz", "classic rectify",
      "classic half wave", "bit crunch noisy", "bit crunch 0 narrow", "bit crunch 0 wide", "bit crunch 1", "bit crunch 2", "bit crunch 3", "octave noise",
      "octave-noise-more", "octave-noisish", "octave a bit", "octave soft", "octave classic", "octave x2", "octave x2 half wave", "asymmetric medium", "asymmetric harder",
      "asymmetric linear and fuzz", "broken amp 1", "broken amp 2", "broken amp 3", "broken amp 4", "broken amp 5"]},
    {"short": "DSTG", "type": "dial", "display": "Distortion Gain", "symbol": "distortionGain", "default": 0, "range": [-48, 48, 0.1, 1, false], "precision": 1, "unit": "dB"},

    {"short": "CPU", "type":"gauge", "gaugetype" : "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "LVL", "type":"gauge", "gaugetype" : "levels", "display": "Level", "symbol": "level", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "FFT", "type":"gauge", "gaugetype" : "spectrogram", "display": "Spectrogram", "symbol": "spectrogram"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1200",
    "WINDOW_HEIGHT": "600",
    "type": "||||",
     "composition": "C=(2:3:3:12) A1=(VOL, REV, LVL*100, CPU*100) A2=(WAV, WRPT, ATT, DEC, SUS) A3=(DSTT, DSTG) A4=(FFT%1))"
  },
  "CPP":
  {
    "CLASS_NAME": "WaveExplorerPedal<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "pedals/WaveExplorerPedal.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
