{
  "name": "ambientpad",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "description": [
    "Ambient pad voice: two morphing wavetable layers through a pole-mixing filter, kept alive by correlated Ornstein-Uhlenbeck modulation instead of a conventional LFO/ADSR matrix. No MIDI input - played from the Note/Play controls or scripted via Lua."
  ],
  "patches": true,
  "use-lua": true,
  "ports-control": [
    {"short": "LEVEL", "type": "dial", "display": "Level", "symbol": "level", "default": -30, "range": [-60, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "NOTE", "type": "dial", "display": "Note", "symbol": "note", "default": 69, "range": [0, 127, 1, 1, false], "precision": 0, "unit": ""},
    {"short": "PLAY", "type": "switch", "display": "Play", "symbol": "play", "default": 0},

    {"short": "MATRL", "type": "dial", "display": "Material", "symbol": "material", "default": 0.5, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "LIGHT", "type": "dial", "display": "Light", "symbol": "light", "default": 0.5, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "MOTION", "type": "dial", "display": "Motion", "symbol": "motion", "default": 0.3, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "BREATH", "type": "dial", "display": "Breath", "symbol": "breath", "default": 0.3, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "STABL", "type": "dial", "display": "Stability", "symbol": "stability", "default": 0.5, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "BLOOM", "type": "dial", "display": "Bloom", "symbol": "bloom", "default": 0.3, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "HOLD", "type": "switch", "display": "Hold", "symbol": "hold", "default": 0},

    {"short": "HARM", "type": "switch", "display": "Harmony", "symbol": "harmonyEnabled", "default": 0},
    {"short": "HOME", "type": "drop", "display": "Home", "symbol": "harmonyHome", "default": 4, "listitems": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]},
    {"short": "CHAR", "type": "drop", "display": "Character", "symbol": "harmonyCharacter", "default": 0, "listitems": ["Any", "Minor Home", "Major Light", "Modal Warmth", "Open/Suspended", "Chromatic"]},
    {"short": "PEDAL", "type": "dial", "display": "Pedal", "symbol": "pedalNote", "default": 0, "range": [0, 127, 1, 1, false], "precision": 0, "unit": ""},

    {"short": "CPU", "type": "gauge", "gaugetype": "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%"},
    {"short": "LVL", "type": "gauge", "gaugetype": "levels", "display": "Level", "symbol": "levelMeter", "default": 0, "range": [0, 100, 0.1, 1, false], "precision": 1, "unit": "%"},
    {"short": "FFT", "type": "gauge", "gaugetype": "spectrogram", "display": "Spectrogram", "symbol": "spectrogram"},

    {"short": "LUACTL", "type": "luacontrolarea", "display": "Lua Controls", "symbol": "luaControls"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1100",
    "WINDOW_HEIGHT": "760",
    "type": "|=",
    "composition": "C=(1:4) R=(1:2) A1=(CPU*200, LVL*300, FFT) A2=(LEVEL, NOTE, PLAY, MATRL, LIGHT, MOTION, BREATH, STABL, BLOOM, HOLD, HARM, HOME, CHAR, PEDAL) A3=(LUACTL)"
  },
  "performance-page": {
    "type": "-",
    "composition": "A1=(PLAY, LEVEL, NOTE, MATRL, LIGHT, MOTION, BREATH, STABL, BLOOM, HOLD, HARM, HOME, CHAR, PEDAL)"
  },
  "processor_forwards": [
    {
      "name": "hasScriptError",
      "type": "bool"
    },
    {
      "name": "scriptErrorMessage",
      "call": "scriptError",
      "type": "std::string"
    },
    {
      "name": "getScriptSkeleton",
      "call": "scriptSkeleton",
      "type": "std::string"
    },
    {
      "name": "getLuaUiParamSlots",
      "call": "uiParamSlots",
      "type": "AmbientPadScriptEngine::UiParamSlots"
    }
  ],
  "extra_timer_callbacks": [
    "pollScriptError();",
    "if (processorRef.hasRunner()) { luaControlsLuaControlArea.refresh(toLuaControlDescriptors(processorRef.getLuaUiParamSlots()), valueTreeState); }"
  ],
  "extra_ui_includes": [
    "impl/LuaControlBridge.h"
  ],
  "CPP": {
    "CLASS_NAME": "AmbientPadImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/AmbientPadImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
