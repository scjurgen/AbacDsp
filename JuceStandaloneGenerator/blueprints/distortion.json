{
  "name": "distortion",
  "displayname": "Distortion",
  "status": "beta",
  "plugintype": "Distortion",
  "lookAndFeel": "inc/LookAndFeel.h",
  "color": "Distortion",
  "micro": 40,
  "minor": 1,
  "major": 0,
  "shortdescription" : "Distortion",
  "description": ["✨ Distortion\n"],
  "transport": [{"name": "transport", "symbol":  "transport"}],
  "ports-control":
  [
    {"short": "LEVL", "type":"dial", "display": "Level", "symbol": "level", "default": 0, "range": [-60,12,0.1,1,false], "precision":1, "unit": "dB" },
    {"short": "TYPE", "type": "drop", "display": "Type", "symbol": "type", "default": 0, "listitems": ["linear cut", "tanh", "atan", "1/sqrt", "rectify"]},
    {"short": "PREL", "type": "dial", "display": "Preboost Low", "symbol": "preboostLow", "default": 0, "range": [-32, 32, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "PREH", "type": "dial", "display": "Preboost High", "symbol": "preboostHigh", "default": 0, "range": [-32, 32, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "CRS", "type": "dial", "display": "Cross Over", "symbol": "crossOver", "default": 800, "range": [100, 10000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "CUT", "type": "dial", "display": "Cut", "symbol": "cut", "default": 8000, "range": [100, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "SIG", "type":"gauge", "gaugetype" : "signal", "display": "Signal", "symbol": "signal"}

  ],
  "layout": {
    "WINDOW_WIDTH": "800",
    "WINDOW_HEIGHT": "400",
    "type": "=",
    "composition": "R=(1:2) A1=(TYPE, LEVL, PREL, PREH, CRS, CUT) A2=(SIG)"
  },
  "CPP":
  {
    "CLASS_NAME": "GenericImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/GenericImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
