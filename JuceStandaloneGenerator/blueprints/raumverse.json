{
  "name": "raumverse",
  "plugintype": "ReverbPlugin",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#ReverbPlugin",
  "description": ["✨ Just an FDN explorer. "],
  "patches": true,
  "ports-control":
  [
    {"short": "ORD", "type": "drop", "display": "Order", "symbol": "order", "default": 8, "listitems": ["2","4","8","12","16","20","24","28","32","36","40","44","48","52","56","60","64"]},
    {"short": "DRY", "type": "dial", "display": "Dry", "symbol": "dry", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "WET", "type": "dial", "display": "Wet", "symbol": "wet", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "SMSZ", "type": "dial", "display": "Smallest size", "symbol": "lowSize", "default": 10, "range": [1.0, 600, 0.01, 0.5, false], "precision": 2, "unit": "m"},
    {"short": "LGSZ", "type": "dial", "display": "Largest size", "symbol": "highSize", "default": 25, "range": [1.0, 600, 0.01, 0.5, false], "precision": 2, "unit": "m"},
    {"short": "UNDL", "type": "switch", "display": "Unique delay", "symbol": "uniqueDelay", "default": 1},
    {"short": "BLG", "type": "dial", "display": "Bulge", "symbol": "bulge", "default":0, "range": [-1, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "DCYL", "type": "dial", "display": "Decay Low", "symbol": "decayLow", "default": 2000, "range": [0, 100000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "CRS", "type": "dial", "display": "Cross Over", "symbol": "crossOver", "default": 800, "range": [100, 10000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "DCYH", "type": "dial", "display": "Decay High", "symbol": "decayHigh", "default": 2000, "range": [0, 100000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "DIV1", "type":"label", "display": "Dispersion", "symbol": "div1"},
    {"short": "APU", "type": "dial", "display": "All pass up", "symbol": "allPassUp", "default": 2000, "range": [20, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "APD", "type": "dial", "display": "All pass down", "symbol": "allPassDown", "default": 1000, "range": [20, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "APC", "type": "drop", "display": "All pass count", "symbol": "allPassCount", "default": 0, "listitems": ["none", "one", "two", "1/4", "1/2", "3/4","All"]},
    {"short": "DIV2", "type":"label", "display": "Filters", "symbol": "div2"},
    {"short": "LPF", "type": "dial", "display": "Low pass", "symbol": "lowPass", "default": 3000, "range": [20, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "LPC", "type": "drop", "display": "Low pass count", "symbol": "lowPassCount", "default": 0, "listitems": ["none", "one", "two", "1/4", "1/2", "3/4","All"]},
    {"short": "HPF", "type": "dial", "display": "High pass", "symbol": "highPass", "default": 3000, "range": [20, 20000, 1, 0.5, false], "precision": 0, "unit": "Hz"},
    {"short": "HPC", "type": "drop", "display": "High pass count", "symbol": "highPassCount", "default": 0, "listitems": ["none", "one", "two", "1/4", "1/2", "3/4","All"]},
    {"short": "MDPT", "type": "dial", "display": "Mod depth", "symbol": "modulationDepth", "default": 0.02, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "MDSP", "type": "dial", "display": "Mod speed", "symbol": "modulationSpeed", "default": 0.25, "range": [0.01, 5, 0.01, 0.5, false], "precision": 2, "unit": "Hz"},
    {"short": "MDC", "type": "drop", "display": "Mod count", "symbol": "modulationCount", "default": 0, "listitems": ["none", "one", "two", "1/4", "1/2", "3/4","All"]},
    {"short": "RVPT", "type": "switch", "display": "Reverse pitch", "symbol": "reversePitch", "default": 0},
    {"short": "PTST", "type": "dial", "display": "Pitch Strength", "symbol": "pitchStrength", "default": 0.5, "range": [0.0, 1.0, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "PT5", "type": "dial", "display": "Pitch 1 inplace", "symbol": "pitch1Inplace", "default": 0, "range": [-12, 12, 0.01, 1, false], "precision": 2, "unit": "st"},
    {"short": "PT6", "type": "dial", "display": "Pitch 2 inplace", "symbol": "pitch2Inplace", "default": 0, "range": [-12, 12, 0.01, 1, false], "precision": 2, "unit": "st"},
    {"short": "PTSZ", "type": "dial", "display": "Pitchsize", "symbol": "pitchSize", "default": 500, "range": [20, 20000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "PT1", "type": "dial", "display": "Pitch 1", "symbol": "pitch1", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "PT2", "type": "dial", "display": "Pitch 2", "symbol": "pitch2", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "PT3", "type": "dial", "display": "Pitch 3", "symbol": "pitch3", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "PT4", "type": "dial", "display": "Pitch 4", "symbol": "pitch4", "default": 0, "range": [-24, 24, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "CPU", "type":"gauge", "gaugetype" : "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "LVL", "type":"gauge", "gaugetype" : "levels", "display": "Level", "symbol": "level", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "FFT", "type":"gauge", "gaugetype" : "spectrogram", "display": "Spectrogram", "symbol": "spectrogram"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1280",
    "WINDOW_HEIGHT": "1024",
    "type": "|=5",
    "composition": "C=(1:12) R=(2:1:1:1:1) A1=(LVL*500,CPU*200) A2=(DCYL, CRS, DCYH, FFT*600) A3=(SMSZ, LGSZ, UNDL, BLG) A4=(APU, APD, APC, LPF, LPC, HPF, HPC) A5=(ORD, DRY, WET, MDPT, MDSP, MDC) A6=(RVPT, PTST, PT5, PT6, PTSZ, PT1, PT2, PT3, PT4)"
  },
  "performance-page": {
    "type": "-",
    "composition": "A1=(LVL)"
  },
  "CPP":
  {
    "CLASS_NAME": "FDNExplorePedal<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "pedals/FDNExplorePedal.h",
    "HINTPROC:" : "Mono-Stereo Mono-Mono Stereo-Stereo",
    "PROCMODE": "Stereo-Stereo"
  }
}
