{
  "name": "SamplePlayer",
  "displayname": "SamplePlayer",
  "status": "beta",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "color": "#eeaaff",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "micro": 127,
  "minor": 1,
  "major": 0,
  "shortdescription": "Just an explorer for MPE reso synth",
  "description": ["✨ Just an explorer for MPE reso synth."],
  "midi-ports-in": [],
  "midi-ports-out": [],
  "audio-ports-in": [{ "name": "in", "symbol":  "in"}],
  "audio-ports-out": [{ "name": "left", "symbol":  "left"},{ "name": "right", "symbol":  "right"}],
  "ports-control":
  [
    {"short": "SYNC", "type":"switch", "display": "Sync", "symbol": "sync", "default": 0 },
    {"short": "TYPE", "type": "drop", "display": "Type", "symbol": "type", "default": 0,
      "listitems": ["PITCHONLY", "DOLPHINS","WIND", "RAINFOREST","FOREST","RAIN","THUNDER","TANPURA","STREAM","OCEAN", "BOWLS","CAFE", "RPGFOREST", "WHITEPULSE" ]},
    {"short": "SUB", "type": "drop", "display": "Subset", "symbol": "subset", "default": 0, "patch": true, "listitems": "#{}", "count": 20},
    {"short": "SOLO", "type": "drop", "display": "Solo", "symbol": "solo", "default": 0, "listitems": ["None","Track 1","Track 2","Track 3","Track 4","Track 5","Track 6","Track 7","Track 8","Track 9","Track 10"]},
    {"short": "VOL", "type": "dial", "display": "Vol", "symbol": "vol", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "REV", "type": "dial", "display": "Reverb Wet", "symbol": "reverbLevelWet", "default": -120, "range": [-120, 0, 1, 1, false], "precision": 0, "unit": "dB"},
    {"short": "REVDC", "type": "dial", "display": "Rev Decay", "symbol": "reverbDecay", "default": 1000, "range": [100, 100000, 1, 0.2, false], "precision": 0, "unit": "ms"},
    {"short": "REVS", "type": "dial", "display": "Rev Shimmer", "symbol": "reverbShimmer", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%"},
    {"short": "V{}", "type": "dial", "display": "Vol {}", "symbol": "vol{}", "count":10, "default": -12, "range": [-100, 0, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "RF{}", "type": "dial", "display": "Rev {}", "symbol": "revFeed{}",  "count":10, "default": -100, "range": [-100, 0, 1, 1, false], "precision": 0, "unit": "dB"},
    {"short": "P{}", "type": "dial", "display": "Pch {}", "symbol": "pitch{}",  "count":10, "default": 0, "range": [-48, 48, 1, 1, false], "precision": 0, "unit": ""},
    {"short": "CPU", "type":"gauge", "gaugetype" : "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%"},
    {"short": "LVL", "type":"gauge", "gaugetype" : "levels", "display": "Level", "symbol": "level", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%"},
    {"short": "FFT", "type":"gauge", "gaugetype" : "spectrogram", "display": "Spectrogram", "symbol": "spectrogram"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1200",
    "WINDOW_HEIGHT": "850",
    "type": "|=4",
     "composition": "C=(1:9) R(1:1:1:3) A1=(SUB,SYNC,TYPE,SOLO,VOL,REV, REVDC, REVS, LVL*100,CPU*100) A2=(V1, V2, V3, V4, V5, V6, V7, V8, V9, V10) A3=(P1, P2, P3, P4, P5, P6, P7, P8, P9, P10) A4=(RF1, RF2, RF3, RF4, RF5, RF6, RF7, RF8, RF9, RF10) A5=(FFT%1))"
  },
  "CPP":
  {
    "CLASS_NAME": "SamplePlayer<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/SamplePlayer.h",
    "PROCMODE": "Stereo-Stereo"
  }
}

