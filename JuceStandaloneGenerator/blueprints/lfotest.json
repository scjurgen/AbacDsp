{
  "name": "lfotest",
  "displayname": "lfotest",
  "status": "beta",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeelOT.h",
  "color": "#eeeeee",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "micro": 127,
  "minor": 1,
  "major": 0,
  "shortdescription": "Just an explorer",
  "description": ["✨ Just an explorer. "],
  "midi-ports-in": [],
  "midi-ports-out": [],
  "audio-ports-in": [{ "name": "in", "symbol":  "in"}],
  "audio-ports-out": [{ "name": "left", "symbol":  "left"},{ "name": "right", "symbol":  "right"}],
  "ports-control":
  [
    {"short": "WAV", "type": "drop", "display": "Wave", "symbol": "wave", "default": 0, "listitems": [ "Sine", "Triangle", "Saw", "Square", "Noise", "SampleHold", "SampleHoldFlipFlop", "BrownNoise"]},
    {"short": "VOL", "type": "dial", "display": "Vol", "symbol": "vol", "default": 0, "range": [-100, 12, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "FRQ", "type": "dial", "display": "Frequency", "symbol": "frequency", "default": 1, "range": [0.01, 20, 0.01, 0.5, false], "precision": 2, "unit": "Hz"},
    {"short": "DFRT", "type": "drop", "display": "Deform type", "symbol": "deformType", "default": 0, "listitems":  ["Square", "Power4", "Power6", "Plateau1", "Plateau2"]},
    {"short": "DFR", "type": "dial", "display": "Deform", "symbol": "deform", "default": 0, "range": [-1, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "GAIN", "type": "dial", "display": "Gain", "symbol": "gain", "default": 1, "range": [-3, 3, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "OFF", "type": "dial", "display": "Offset", "symbol": "offset", "default": 0, "range": [-1, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "CLP", "type": "dial", "display": "Clip", "symbol": "clip", "default": 1, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "PHS", "type": "dial", "display": "Phase", "symbol": "phase", "default": 0, "range": [0, 360, 10, 1, false], "precision": 0, "unit": "deg"},
    {"short": "SMTH", "type": "dial", "display": "Smooth", "symbol": "smooth", "default": 0, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "OUTT", "type": "drop", "display": "Output Type", "symbol": "outputType", "default": 0, "listitems":  ["bipolar", "unipolar", "abs", "clip negative"]},
    {"short": "DSC", "type": "dial", "display": "Discrete", "symbol": "discrete", "default": 0, "range": [0, 32, 1, 1, false], "precision": 0, "unit": "steps"},
    {"short": "CPU", "type":"gauge", "gaugetype" : "cpuload", "display": "CPU", "symbol": "cpu", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "LVL", "type":"gauge", "gaugetype" : "levels", "display": "Level", "symbol": "level", "default": 0, "range": [0, 100, 0.1, 1, false], "precision":1, "unit": "%" },
    {"short": "SIG", "type":"gauge", "gaugetype" : "signal", "display": "Signal", "symbol": "signal"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1200",
    "WINDOW_HEIGHT": "600",
    "type": "||||",
     "composition": "C=(1:3:3:12) A1=(VOL,LVL*100,CPU*100) A2=(WAV,FRQ,DFRT,DFR, GAIN,CLP) A3=(OFF,PHS,SMTH,OUTT, DSC) A4=(SIG%1))"
  },
  "CPP":
  {
    "CLASS_NAME": "LfoExplorePedal<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "pedals/LfoExplorePedal.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
