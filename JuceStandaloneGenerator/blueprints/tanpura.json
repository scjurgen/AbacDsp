{
  "name": "tanpura",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "description": ["✨ Tanpura drone synth - plucked-string simulation of the Indian drone instrument."],
  "patches": true,
  "ports-control":
  [
    {"short": "KEY", "type": "drop", "display": "Key", "symbol": "key", "default": 12, "listitems": ["C0", "C#/Db0", "D0", "D#/Eb0", "E0", "F0", "F#/Gb0", "G0", "G#/Ab0", "A0", "Bb0", "B0", "C1", "C#/Db1", "D1", "D#/Eb1", "E1", "F1", "F#/Gb1", "G1", "G#/Ab1", "A1", "Bb1", "B1", "C2", "C#/Db2", "D2", "D#/Eb2", "E2", "F2", "F#/Gb2", "G2", "G#/Ab2", "A2", "Bb2", "B2", "C3"]},
    {"short": "VOL", "type": "dial", "display": "Level", "symbol": "level", "default": 0, "range": [-80, 0, 0.1, 1, false], "precision": 1, "unit": "dB"},
    {"short": "TUNE", "type": "dial", "display": "Tuning", "symbol": "tuning", "default": 440, "range": [400, 800, 0.1, 1, false], "precision": 1, "unit": "Hz"},

    {"short": "DET1", "type": "dial", "display": "Detune 1", "symbol": "detuneString1", "default": 0, "range": [-50, 50, 1, 1, false], "precision": 0, "unit": "ct"},
    {"short": "DET2", "type": "dial", "display": "Detune 2", "symbol": "detuneString2", "default": 5, "range": [-50, 50, 1, 1, false], "precision": 0, "unit": "ct"},
    {"short": "DET3", "type": "dial", "display": "Detune 3", "symbol": "detuneString3", "default": -5, "range": [-50, 50, 1, 1, false], "precision": 0, "unit": "ct"},
    {"short": "DET4", "type": "dial", "display": "Detune 4", "symbol": "detuneString4", "default": 7, "range": [-50, 50, 1, 1, false], "precision": 0, "unit": "ct"},
    {"short": "DET5", "type": "dial", "display": "Detune 5", "symbol": "detuneString5", "default": -2, "range": [-50, 50, 1, 1, false], "precision": 0, "unit": "ct"},

    {"short": "PATT", "type": "drop", "display": "Pattern", "symbol": "pattern", "default": 0, "listitems": ["H1 H2 1 -", "H1 H2 8 1 -", "H1 H2 8 8 1 -", "H1 H2 - 8 8 1 -"]},
    {"short": "SLIDE", "type": "dial", "display": "Slide", "symbol": "slide", "default": 0, "range": [0, 100, 1, 1, false], "precision": 0, "unit": "%"},
    {"short": "SLDT", "type": "dial", "display": "Slide Time", "symbol": "slideTime", "default": 150, "range": [1, 3000, 0.1, 0.35, false], "precision": 1, "unit": "ms"},
    {"short": "HARM1", "type": "drop", "display": "Set Harmonic 1", "symbol": "harmonicFirst", "default": 7, "listitems": ["-12 sā सा", "-11", "-10 re र", "-9", "-8 ga ग", "-7 ma म", "-6", "-5 pa प", "-4", "-3 dha ध", "-2", "-1 ni नी", "0 Sā सा", "1", "2 re र", "3", "4 ga ग", "5 ma म", "6", "7 pa प", "8", "9 dha ध", "10", "11 ni नी", "0 Sā सा"]},
    {"short": "HARM2", "type": "drop", "display": "Set Harmonic 2", "symbol": "harmonicSecond", "default": 0, "listitems": ["-12 sā सा", "-11", "-10 re र", "-9", "-8 ga ग", "-7 ma म", "-6", "-5 pa प", "-4", "-3 dha ध", "-2", "-1 ni नी", "0 Sā सा", "1", "2 re र", "3", "4 ga ग", "5 ma म", "6", "7 pa प", "8", "9 dha ध", "10", "11 ni नी", "0 Sā सा"]},
    {"short": "PLAY", "type": "switch", "display": "Play", "symbol": "playStop", "default": 0},
    {"short": "PPM", "type": "dial", "display": "Picks/M", "symbol": "picksPerMinute", "default": 100, "range": [5, 400, 1, 1, false], "precision": 0, "unit": ""},
    {"short": "PAUSE", "type": "dial", "display": "Pause", "symbol": "pauseLength", "default": 10, "range": [1, 30000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},

    {"short": "ATK", "type": "dial", "display": "Attack", "symbol": "attack", "default": 10, "range": [1, 3000, 0.1, 0.35, false], "precision": 1, "unit": "ms"},
    {"short": "DCY", "type": "dial", "display": "Decay", "symbol": "decay", "default": 10, "range": [1, 30000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "SUS", "type": "dial", "display": "Sustain", "symbol": "levelSustain", "default": 0.2, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "LFOD", "type": "dial", "display": "Filter LFO Depth", "symbol": "lfoDepth", "default": 0.5, "range": [0, 2, 0.01, 1, false], "precision": 2, "unit": ""},

    {"short": "ATKF", "type": "dial", "display": "Filter Attack", "symbol": "attackFilter", "default": 10, "range": [1, 3000, 0.1, 0.35, false], "precision": 1, "unit": "ms"},
    {"short": "DCYF", "type": "dial", "display": "Filter Decay", "symbol": "decayFilter", "default": 10, "range": [1, 30000, 0.1, 0.25, false], "precision": 1, "unit": "ms"},
    {"short": "SUSF", "type": "dial", "display": "Filter Sustain", "symbol": "levelSustainFilter", "default": 0, "range": [0, 1, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "CUTF", "type": "dial", "display": "Filter Cutoff", "symbol": "filterCutoff", "default": 0, "range": [-60, 48, 0.1, 1, false], "precision": 1, "unit": "st"},
    {"short": "RESF", "type": "dial", "display": "Filter Resonance", "symbol": "filterResonance", "default": 0.1, "range": [0, 2, 0.01, 1, false], "precision": 2, "unit": ""},
    {"short": "CONTF", "type": "dial", "display": "Contour F", "symbol": "contourFilter", "default": 0, "range": [-4, 4, 0.01, 1, false], "precision": 2, "unit": "oct"}
  ],
  "layout": {
    "WINDOW_WIDTH": "1400",
    "WINDOW_HEIGHT": "800",
    "type": "|||||",
    "composition": "C=(1:1:1:1:1) A1=(KEY,VOL,TUNE) A2=(DET1,DET2,DET3,DET4,DET5) A3=(PATT,SLIDE,SLDT,HARM1,HARM2,PLAY) A4=(PPM,PAUSE,ATK,DCY,SUS,LFOD) A5=(ATKF,DCYF,SUSF,CUTF,RESF,CONTF))"
  },
  "CPP":
  {
    "CLASS_NAME": "TanpuraImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/TanpuraImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}