{
  "name": "pingsynth",
  "plugintype": "InstrumentPlugin",
  "lookAndFeel": "LookAndFeel.h",
  "boxy": "boxy",
  "plugintype-see-also": "http://lv2plug.in/ns/lv2core#InstrumentPlugin",
  "description": [
    "✨ Lua-scripted resonator synth: a patch's script builds an arbitrary harmonic list per note and fires it into a bank of ringing resonators."
  ],
  "patches": true,
  "use-lua": true,
  "ports-control": [
    {
      "short": "MODE",
      "type": "drop",
      "display": "Mode",
      "symbol": "mode",
      "default": 1,
      "signed": false,
      "listitems": [
        "polyphonic",
        "mpe"
      ]
    },
    {
      "short": "VOL",
      "type": "dial",
      "display": "Vol",
      "symbol": "vol",
      "default": 0,
      "range": [
        -100,
        12,
        0.1,
        1,
        false
      ],
      "precision": 1,
      "unit": "dB"
    },
    {
      "short": "REV",
      "type": "dial",
      "display": "Reverb",
      "symbol": "reverbLevel",
      "default": -24,
      "range": [
        -120,
        0,
        1,
        1,
        false
      ],
      "precision": 0,
      "unit": "dB"
    },
    {
      "short": "CPU",
      "type": "gauge",
      "gaugetype": "cpuload",
      "display": "CPU",
      "symbol": "cpu",
      "default": 0,
      "range": [
        0,
        100,
        0.1,
        1,
        false
      ],
      "precision": 1,
      "unit": "%"
    },
    {
      "short": "LVL",
      "type": "gauge",
      "gaugetype": "levels",
      "display": "Level",
      "symbol": "level",
      "default": 0,
      "range": [
        0,
        100,
        0.1,
        1,
        false
      ],
      "precision": 1,
      "unit": "%"
    },
    {
      "short": "FFT",
      "type": "gauge",
      "gaugetype": "spectrogram",
      "display": "Spectrogram",
      "symbol": "spectrogram"
    },
    {
      "short": "LUACTL",
      "type": "luacontrolarea",
      "display": "Lua Controls",
      "symbol": "luaControls"
    }
  ],
  "layout": {
    "WINDOW_WIDTH": "1200",
    "WINDOW_HEIGHT": "800",
    "type": "|=",
    "composition": "C=(1:12) R=(1:1) A1=(CPU*200, LVL*500) A2=(MODE, VOL, REV, FFT*600) A3=(LUACTL)"
  },
  "performance-page": {
    "type": "=",
    "composition": "A1=(LVL) A2=(LUACTL)"
  },
  "processor_forwards": [
    {
      "name": "hasScriptError",
      "type": "bool"
    },
    {
      "name": "scriptErrorMessage",
      "call": "scriptError",
      "type": "std::string"
    },
    {
      "name": "getScriptSkeleton",
      "call": "scriptSkeleton",
      "type": "std::string"
    },
    {
      "name": "getLuaUiParamSlots",
      "call": "uiParamSlots",
      "type": "PingsynthScriptEngine::UiParamSlots"
    }
  ],
  "extra_timer_callbacks": [
    "pollScriptError();",
    "pollLlmAssistWatcher();",
    "if (processorRef.hasRunner()) { luaControlsLuaControlArea.refresh(toLuaControlDescriptors(processorRef.getLuaUiParamSlots()), valueTreeState); }"
  ],
  "extra_ui_includes": [
    "impl/LuaControlBridge.h"
  ],
  "CPP": {
    "CLASS_NAME": "PingsynthImpl<NumSamplesPerBlock>",
    "INCLUDE_PEDAL": "impl/PingsynthImpl.h",
    "PROCMODE": "Stereo-Stereo"
  }
}
